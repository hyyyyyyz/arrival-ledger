log_format arrival_upload_diagnostic escape=json
    '{"event":"receipt_upload","time":"$time_iso8601",'
    '"request_id":"$request_id","method":"$request_method","path":"$uri",'
    '"status":$status,"content_length":"$http_content_length",'
    '"request_length":$request_length,"request_time":$request_time,'
    '"upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time"}';

# Match the normalized path, never query parameters. Keep other API access logs
# in the image's existing main format; receipt uploads use the safe diagnostic.
map $uri $arrival_upload_log_enabled {
    default 0;
    /api/receipts 1;
}

map $uri $arrival_standard_api_log_enabled {
    default 1;
    /api/receipts 0;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 15m;

    location /api/ {
        access_log /var/log/nginx/access.log main if=$arrival_standard_api_log_enabled;
        access_log /var/log/nginx/access.log arrival_upload_diagnostic if=$arrival_upload_log_enabled;

        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 90s;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|svg|png|jpg|jpeg|webp|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }
}
