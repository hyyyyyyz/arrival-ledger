# Copy to /var/lib/arrival-ledger/pdd/config/.env.local and keep mode 0640 or stricter.
# This file intentionally contains no valid worker credential.
ARRIVAL_API_BASE_URL=http://backend:8000
ARRIVAL_SYNC_WORKER_KEY=CHANGE_ME_PRIVATE_WORKER_KEY
ARRIVAL_WORKER_ID=pdd-server-01

PDD_ACCOUNTS_FILE=/data/config/pdd-accounts.json
ARRIVAL_STATE_DIR=/data/state
ARRIVAL_LOG_DIR=/data/logs

# Start conservatively. All PDD accounts are processed strictly one at a time.
SYNC_MAX_PAGES=1
SYNC_MAX_RECORDS=20
SYNC_PAGE_DELAY_MS=3000
SYNC_MIN_INTERVAL_MINUTES=30
