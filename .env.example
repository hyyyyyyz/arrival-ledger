# Copy this file to .env, then replace every value marked CHANGE_ME.
# Keep .env private: chmod 600 .env

TZ=Asia/Shanghai
DATA_ROOT=/home/jackson/arrival-manager-data
BIND_ADDRESS=0.0.0.0
APP_PORT=8766

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS

# LAN prototype: false means the private LAN page opens directly without login.
# Set true before exposing the service through Quick Tunnel or any public URL.
AUTH_REQUIRED=false
TRUSTED_USER_USERNAME=admin
TRUSTED_LAN_CIDRS=192.168.1.0/24
TRUSTED_HOSTS=192.168.1.5

# Used only to create/ensure the initial private administrator account.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_UNIQUE_PASSWORD

# false for the initial LAN URL (http://192.168.1.5:8766).
# Set true before using any HTTPS public URL, including Quick Tunnel.
COOKIE_SECURE=false

# 12 MiB. Nginx allows a little multipart overhead and the backend enforces this value.
MAX_UPLOAD_BYTES=12582912

# --- Windows sync-agent batch ingest (optional; sync endpoint stays 503 when empty) ---
# Comma-separated worker tokens, each at least 16 chars, e.g. generated with:
# openssl rand -hex 24
# The plaintext tokens live ONLY here (server .env) and in the Windows machine's
# .env.local; the database stores only HMAC digests and logs never print the token.
# Tokens removed from this list are revoked on the next backend startup (this is
# how rotation works). Never commit tokens.
SYNC_WORKER_TOKENS=

# At most N accepted batches per hour per worker token (1..60).
SYNC_RATE_LIMIT_PER_HOUR=6

# Hard server-side caps for a single batch payload.
SYNC_MAX_BATCH_ORDERS=100
SYNC_MAX_BATCH_BYTES=262144

# Optional image overrides used for explicit release pinning or rollback.
BACKEND_IMAGE=arrival-ledger-backend:local
FRONTEND_IMAGE=arrival-ledger-frontend:local
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
